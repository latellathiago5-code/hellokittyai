# ============================================================
# Hello Kitty AI - configuración
# ============================================================
# 1. Copiá este archivo como ".env" (si no existe).
# 2. Elegí un proveedor y pegá tu API key.
# 3. Reiniciá el servidor con: npm start

# ---- Opción A: Google Gemini (recomendada) ----
# Key gratis: https://aistudio.google.com/apikey
AI_PROVIDER=gemini
GEMINI_API_KEY=
AI_MODEL=gemini-3-flash-preview
AI_VISION_MODEL=gemini-3-flash-preview

# ---- Opción B: Groq ----
# Key gratis: https://console.groq.com/keys
# AI_PROVIDER=groq
# GROQ_API_KEY=
# AI_MODEL=llama-3.3-70b-versatile
# AI_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# ---- Opción C: OpenRouter (acceso a muchos modelos) ----
# Key: https://openrouter.ai/keys
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-or-v1-...
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=google/gemini-2.5-flash
# AI_VISION_MODEL=google/gemini-2.5-flash

# ---- Opción D: otro proveedor compatible con OpenAI ----
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# AI_VISION_MODEL=gpt-4o-mini

# Puerto del servidor
PORT=3000

# Para probar sin API key: AI_MOCK=1
# AI_MOCK=0
